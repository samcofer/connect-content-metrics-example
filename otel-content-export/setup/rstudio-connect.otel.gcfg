; Posit Connect server configuration for per-content OpenTelemetry export.
; Add these sections to /etc/rstudio-connect/rstudio-connect.gcfg (merge with
; your existing [Server]/[Python]/[R]/[Quarto] settings) and restart Connect.
;
; In production, point the [OTLPEndpoint] at the LOCAL Datadog Agent's OTLP
; receiver (the Agent handles auth to the Datadog backend). Connect appends the
; signal paths (/v1/traces, /v1/logs, /v1/metrics) automatically.

[OpenTelemetry]
Enabled = true
; Default is true. Controls whether content processes may be instrumented.
AllowContentInstrumentation = true
; Stamped as the service.namespace resource attribute on every signal
; (server, content, package builders). Group/filter by this per environment.
ServiceNamespace = "ird-sas-demo"
; PublicTracesOnly defaults to true: the embedded collector only forwards spans
; whose is_public attribute is true to the [OTLPEndpoint]; everything else stays
; on-host. The content example sets is_public=true on its own resource span, so
; leave this at the default. Set it to false ONLY if you want ALL content spans
; forwarded without the per-span attribute (both are internal settings).
; PublicTracesOnly = false

; Fan signals out to a locally running OTLP/HTTP collector or agent.
; For Datadog: Endpoint = http://localhost:4318 (the Datadog Agent's OTLP intake).
[OTLPEndpoint "datadog"]
Endpoint = "http://127.0.0.1:4318"
Traces = true
Logs = true
Metrics = true
